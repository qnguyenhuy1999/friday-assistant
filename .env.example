# Phase 12: Obsidian memory and derived Graphify index (opt in intentionally).
# Memory is opt-in. Enabling it with a bad allowlist/vault now fails worker
# startup and preflight rather than silently disabling memory.
FRIDAY_MEMORY_ENABLED=false
FRIDAY_OBSIDIAN_VAULT_ROOT=~/Documents/secondbrain
FRIDAY_OBSIDIAN_MANAGED_ROOT=Friday
FRIDAY_MEMORY_INCLUDE_GLOBS=00-Inbox/**/*.md,10-Projects/**/*.md,20-Areas/**/*.md,30-Resources/**/*.md,40-Meetings/**/*.md,50-Decisions/**/*.md,60-Specifications/**/*.md,70-Architecture/**/*.md,80-Incidents/**/*.md,90-Reports/**/*.md
FRIDAY_MEMORY_EXCLUDE_GLOBS=.obsidian/**,.trash/**,.claude/**,.git/**,**/.DS_Store,**/.git/**,**/node_modules/**,graphify-out/**,Attachments/**,Templates/**,**/*.canvas,**/*.pdf,**/*.png,**/*.jpg,**/*.jpeg,**/*.gif,**/*.mov,**/*.mp4,**/*.zip
FRIDAY_MEMORY_MAX_FILES=5000
FRIDAY_MEMORY_MAX_NOTE_BYTES=1000000
FRIDAY_MEMORY_MAX_CANDIDATES=50
FRIDAY_MEMORY_MAX_EXCERPTS=6
FRIDAY_MEMORY_MAX_EXCERPT_CHARS=2000
FRIDAY_MEMORY_MAX_TOTAL_CONTEXT_CHARS=12000
FRIDAY_MEMORY_MAX_GRAPH_DEPTH=2
FRIDAY_MEMORY_MAX_GRAPH_NODES_VISITED=500
FRIDAY_GRAPHIFY_ENABLED=false
FRIDAY_GRAPHIFY_EXECUTABLE=graphify
FRIDAY_GRAPHIFY_INDEX_ROOT=~/.friday/graphify
FRIDAY_GRAPHIFY_BUILD_TIMEOUT_SECONDS=900
FRIDAY_GRAPHIFY_MAX_STDOUT_BYTES=200000
FRIDAY_GRAPHIFY_MAX_STDERR_BYTES=200000
FRIDAY_GRAPHIFY_MAX_GRAPH_BYTES=50000000
FRIDAY_MEMORY_INDEX_MAINTENANCE_SECONDS=900
FRIDAY_MEMORY_INDEX_MAX_FILES_PER_SCAN=5000

# Phase 13: opt-in Cua Driver computer use. Mutations always require approval.
FRIDAY_COMPUTER_USE_ENABLED=false
FRIDAY_CUA_DRIVER_CMD="cua-driver mcp"
FRIDAY_COMPUTER_TIMEOUT_SECONDS=15
FRIDAY_COMPUTER_MAX_CAPTURE_BYTES=8000000
FRIDAY_COMPUTER_MAX_TYPE_CHARS=4096
FRIDAY_COMPUTER_MAX_SCROLL_AMOUNT=10
FRIDAY_COMPUTER_MAX_ELEMENTS=500
# Maps to CUA_DRIVER_RS_TELEMETRY_ENABLED for the child driver process.
FRIDAY_CUA_TELEMETRY_ENABLED=false

# Phase 14: API delivery settings. Comma-separated browser origins; set an
# empty value to disable cross-origin browser access entirely.
FRIDAY_API_DATABASE_URL=sqlite:///./friday.db
FRIDAY_API_HOST=127.0.0.1
# Retained only so legacy configurations fail with an actionable message.
# Remote binding is unsupported until authenticated transport is implemented.
FRIDAY_API_ALLOW_REMOTE_BIND=false
FRIDAY_API_PORT=8000
FRIDAY_API_SSE_POLL_INTERVAL_SECONDS=0.5
FRIDAY_API_MAX_REQUEST_BYTES=1048576
FRIDAY_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Phase 16: durable scheduled automations. Invalid values fail worker startup.
FRIDAY_SCHEDULER_ENABLED=true
