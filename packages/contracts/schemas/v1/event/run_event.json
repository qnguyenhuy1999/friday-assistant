{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.friday-agent-os.dev/v1/event/run_event.json",
  "title": "RunEvent",
  "description": "An append-only fact emitted during Run execution, ordered by sequence. Mirrors friday.domain.event.RunEvent. Memory event payloads are bounded metadata only and must not contain note bodies, query text, absolute paths, Graphify stderr, or model prompts.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "../definitions/identifier.json"
    },
    "run_id": {
      "$ref": "../definitions/identifier.json"
    },
    "type": {
      "enum": [
        "run_created",
        "run_started",
        "run_waiting_for_approval",
        "run_waiting_for_delegation",
        "run_resumed",
        "run_succeeded",
        "run_failed",
        "run_cancelled",
        "step_created",
        "step_started",
        "step_succeeded",
        "step_failed",
        "step_skipped",
        "step_cancelled",
        "approval_requested",
        "approval_resolved",
        "tool_invocation_requested",
        "tool_invocation_started",
        "tool_invocation_succeeded",
        "tool_invocation_failed",
        "tool_invocation_cancelled",
        "artifact_created",
        "agent_finished",
        "delegation_dispatched",
        "delegation_succeeded",
        "delegation_failed",
        "delegation_cancelled",
        "memory_context_attached",
        "memory_retrieval_degraded",
        "memory_write_requested",
        "memory_write_committed",
        "memory_write_conflicted",
        "memory_index_marked_stale",
        "workflow_execution_started",
        "workflow_node_dispatched",
        "workflow_node_succeeded",
        "workflow_node_failed",
        "workflow_node_cancelled",
        "workflow_node_blocked",
        "workflow_execution_succeeded",
        "workflow_execution_failed"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "$ref": "../definitions/timestamp.json"
    },
    "payload": {
      "$ref": "../definitions/json_value.json"
    },
    "step_id": {
      "anyOf": [
        {
          "$ref": "../definitions/identifier.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "run_id",
    "type",
    "sequence",
    "occurred_at",
    "payload",
    "step_id"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "memory_context_attached",
              "memory_retrieval_degraded",
              "memory_write_requested",
              "memory_write_committed",
              "memory_write_conflicted",
              "memory_index_marked_stale"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "record_id": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "record_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 256
                    },
                    "maxItems": 5000
                  },
                  "candidate_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "excerpt_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "vault_relative_path": {
                    "type": "string",
                    "maxLength": 1024,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).*$"
                  },
                  "source_snapshot_id": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "index_snapshot_id": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "failure_code": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "retrieval_mode": {
                    "type": "string",
                    "maxLength": 128
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      }
    }
  ]
}
