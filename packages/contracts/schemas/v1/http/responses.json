        "expires_at": { "type": ["string", "null"] },
        "resolved_at": { "type": ["string", "null"] },
        "resolution_note": { "type": ["string", "null"] },
        "resolver": { "type": ["string", "null"] },
        "authorization_fingerprint": { "type": ["string", "null"] },
        "consumed_at": { "type": ["string", "null"] },
        "subject_kind": {
          "enum": ["run", "skill_promotion", "skill_rollback"]
