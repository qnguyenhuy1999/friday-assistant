      ],
      "properties": {
        "id": { "type": "string" },
        "key": { "type": "string" },
        "display_name": { "type": "string" },
        "description": { "type": "string" },
        "status": { "enum": ["active", "disabled", "archived"] },
        "active_revision_id": { "type": ["string", "null"] },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
