      "properties": {
        "artifact_id": { "type": "string" },
        "run_id": { "type": "string" },
        "step_id": { "type": ["string", "null"] },
        "kind": {
          "enum": ["text", "file", "directory", "url", "json", "image", "other"]
        },
        "name": { "type": "string" },
        "media_type": { "type": "string" },
        "location": { "type": "string" },
        "created_at": { "type": "string" },
        "size": { "type": ["integer", "null"] },
        "checksum": { "type": ["string", "null"] },
        "metadata": {}
      }
    },
    "RunEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "run_id",
        "step_id",
        "type",
        "sequence",
        "occurred_at",
        "payload"
      ],
      "properties": {
        "event_id": { "type": "string" },
        "run_id": { "type": "string" },
        "step_id": { "type": ["string", "null"] },
        "type": {
          "enum": [
            "run_created",
            "run_started",
            "run_waiting_for_approval",
            "run_waiting_for_delegation",
            "run_resumed",
            "run_succeeded",
            "run_failed",
            "run_cancelled",
            "step_created",
            "step_started",
            "step_succeeded",
            "step_failed",
            "step_skipped",
            "step_cancelled",
            "approval_requested",
            "approval_resolved",
            "tool_invocation_requested",
            "tool_invocation_started",
            "tool_invocation_succeeded",
            "tool_invocation_failed",
            "tool_invocation_cancelled",
            "artifact_created",
            "agent_finished",
            "delegation_dispatched",
            "delegation_succeeded",
            "delegation_failed",
            "delegation_cancelled",
            "memory_context_attached",
            "memory_retrieval_degraded",
            "memory_write_requested",
            "memory_write_committed",
            "memory_write_conflicted",
            "memory_index_marked_stale"
