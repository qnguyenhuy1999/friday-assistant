    "ToolInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocation_id",
        "run_id",
        "step_id",
        "tool_name",
        "status",
        "requested_at",
        "approval_request_id",
        "output",
        "output_set",
        "failure"
