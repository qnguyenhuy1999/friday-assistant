        "requested_at": { "type": "string" },
        "approval_request_id": { "type": ["string", "null"] },
        "output": {},
        "output_set": { "type": "boolean" },
        "failure": {
          "anyOf": [{ "$ref": "#/definitions/Failure" }, { "type": "null" }]
        }
      }
    },
    "Artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "run_id",
        "step_id",
        "kind",
        "name",
        "media_type",
        "location",
        "created_at",
        "size",
        "checksum",
        "metadata"
